{
  "name": "pendo-verification-utility",
  "version": "1.0.0",
  "description": "Pendo PII detection and verification utility for development",
  "scripts": {
    "test": "jest",
    "test:only": "jest",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "verify": "node scripts/verify-pendo-ci.js",
    "setup:hooks": "npm install --save-dev husky && npx husky init && chmod +x .husky/pre-commit .husky/pre-push",
    "prepare": "command -v husky >/dev/null 2>&1 && husky || echo 'Husky not installed, skipping hooks'"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-jest": "^29.1.5",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "keywords": [
    "pendo",
    "pii",
    "security",
    "verification",
    "testing",
    "development"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "20": "^3.1.9",
    "node": "^24.12.0"
  }
}
