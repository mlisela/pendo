#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Run full verification suite before push
echo "🔍 Running full Pendo verification suite..."

# Run type check
echo "📝 Checking TypeScript..."
npm run type-check

if [ $? -ne 0 ]; then
  echo "❌ TypeScript compilation failed. Push blocked."
  exit 1
fi

# Run tests
echo "🧪 Running tests..."
npm test

if [ $? -ne 0 ]; then
  echo "❌ Tests failed. Push blocked."
  exit 1
fi

# Run verification
echo "🔍 Running Pendo verification..."
npm run verify

if [ $? -ne 0 ]; then
  echo "❌ Pendo verification failed. Push blocked."
  exit 1
fi

echo "✅ All checks passed! Pushing..."

